{
  "name": "enterprise-os",
  "version": "1.6.0",
  "description": "Enterprise OS — Evidence-Driven Product Learning Platform (Kernel + Engines)",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "eos:observe": "PYTHONPATH=implementation python3 implementation/eos/engines/observer/engine.py",
    "eos:validate": "PYTHONPATH=implementation python3 implementation/eos/engines/validator/engine.py",
    "eos:status": "PYTHONPATH=implementation python3 implementation/eos/kernel/cli/status-reader.py",
    "eos:pattern": "PYTHONPATH=implementation python3 implementation/eos/engines/pattern/engine.py",
    "eos:doctor": "PYTHONPATH=implementation python3 implementation/eos/engines/doctor/engine.py lawyershub",
    "eos": "pnpm --dir ./workspace eos",
    "test": "cd workspace && pnpm vitest run capabilities/product-delivery/test/delivery.test.ts",
    "test:del001": "cd workspace && pnpm vitest run capabilities/product-delivery/test/delivery.test.ts",
    "test:ret001": "cd workspace && pnpm vitest run capabilities/retail-inventory/test/retail-inventory.test.ts",
    "test:watch": "cd workspace && pnpm vitest capabilities/product-delivery/test/delivery.test.ts"
  },
  "keywords": [
    "enterprise-os",
    "evidence-driven",
    "governance",
    "kernel",
    "engines"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "k6": "^0.0.0",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^3.2.7",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "next": "^16.3.6",
    "sharp": "^0.35.4"
  }
}