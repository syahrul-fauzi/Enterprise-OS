{
  "extends": "../../config/typescript/nextjs.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@repo/presentation-hooks": ["../../packages/presentation/hooks/dist"],
      "@repo/presentation-hooks/*": ["../../packages/presentation/hooks/dist/*"],
      "@repo/presentation-templates": ["../../packages/presentation/templates/dist"],
      "@repo/presentation-templates/*": ["../../packages/presentation/templates/dist/*"],
      "@repo/capabilities-identity": ["../../capabilities/identity/dist"],
      "@repo/capabilities-identity/*": ["../../capabilities/identity/dist/*"],
      "@repo/presentation-ui-system": ["../../packages/presentation/ui-system/dist"],
      "@repo/presentation-ui-system/*": ["../../packages/presentation/ui-system/dist/*"],
      "@repo/composition": ["../../packages/composition/dist"],
      "@repo/composition/*": ["../../packages/composition/dist/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": ["node_modules"]
}