{
  "extends": "@repo/config-typescript/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node"],
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./*"],
      "@repo/core-kernel": ["../../packages/core/kernel/src/index.ts"],
      "@repo/core-kernel/*": ["../../packages/core/kernel/src/*"],
      "@repo/core-runtime": ["../../packages/core/runtime/src/index.ts"],
      "@repo/core-runtime/*": ["../../packages/core/runtime/src/*"],
      "@repo/composition": ["../../packages/composition/src/index.ts"],
      "@repo/composition/*": ["../../packages/composition/src/*"],
      "@repo/core-capability-registry": ["../../packages/core/capability-registry/src/index.ts"],
      "@repo/core-capability-registry/*": ["../../packages/core/capability-registry/src/*"],
      "@repo/presentation-ui-system": ["../../packages/presentation/ui-system/dist/index.js"],
      "@repo/presentation-ui-system/*": ["../../packages/presentation/ui-system/dist/*"],
      "@repo/presentation-foundation": ["../../packages/presentation/foundation/dist/index.js"],
      "@repo/presentation-foundation/*": ["../../packages/presentation/foundation/dist/*"],
      "@repo/presentation-widgets": ["../../packages/presentation/widgets/dist/index.js"],
      "@repo/presentation-widgets/*": ["../../packages/presentation/widgets/dist/*"],
      "@repo/presentation-features": ["../../packages/presentation/features/dist/index.js"],
      "@repo/presentation-features/*": ["../../packages/presentation/features/dist/*"],
      "@repo/presentation-experience": ["../../packages/presentation/experience/dist/index.js"],
      "@repo/presentation-experience/*": ["../../packages/presentation/experience/dist/*"],
      "@repo/presentation-hooks": ["../../packages/presentation/hooks/dist/index.js"],
      "@repo/presentation-hooks/*": ["../../packages/presentation/hooks/dist/*"],
      "@repo/presentation-entities": ["../../packages/presentation/entities/dist/index.js"],
      "@repo/presentation-entities/*": ["../../packages/presentation/entities/dist/*"],
      "@repo/presentation-templates": ["../../packages/presentation/templates/dist/index.js"],
      "@repo/presentation-templates/*": ["../../packages/presentation/templates/dist/*"],
      "@repo/presentation-pages": ["../../packages/presentation/pages/dist/index.js"],
      "@repo/presentation-pages/*": ["../../packages/presentation/pages/dist/*"],
      "@repo/capabilities-identity": ["../../capabilities/identity/implementation/index.ts"],
      "@repo/capabilities-identity/*": ["../../capabilities/identity/implementation/*"],
      "@products/*": ["../../products/*"],
      "@procedures/*": ["../../procedures/*"],
      "@procedures": ["../../procedures/index"],
      "@capabilities/*": ["../../capabilities/*"],
      "@legal-case/*": ["../../capabilities/legal-case/*"],
      "legal-case/*": ["../../capabilities/legal-case/*"],
      "legal-document/*": ["../../capabilities/legal-document/*"],
      "communication/*": ["../../capabilities/communication/*"],
      "service-directory/*": ["../../capabilities/service-directory/*"],
      "legal-community/*": ["../../capabilities/legal-community/*"],
      "requirements-traceability-matrix/*": ["../../capabilities/requirements-traceability-matrix/*"],
      "requirement-management/*": ["../../capabilities/requirement-management/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "../../procedures/**/*.ts",
    "../../capabilities/legal-case/**/*.ts",
    "../../capabilities/legal-case/**/*.tsx",
    "../../capabilities/legal-document/**/*.ts",
    "../../capabilities/legal-document/**/*.tsx",
    "../../capabilities/communication/**/*.ts",
    "../../capabilities/communication/**/*.tsx",
    "../../capabilities/identity/**/*.ts",
    "../../capabilities/identity/**/*.tsx",
    "../../capabilities/persistent-companion/**/*.ts",
    "../../capabilities/persistent-companion/**/*.tsx",
    "../../capabilities/connector-ecosystem/**/*.ts",
    "../../capabilities/connector-ecosystem/**/*.tsx"
  ],
  "exclude": ["node_modules", "tests", "../../procedures/**/tests/**", "../../procedures/**/*.test.ts", "../../procedures/**/audit-conformance.ts"]
}