{
  "extends": "../../config/typescript/nextjs.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "paths": {
      "*": ["./*"],
      "@/*": ["./*"],
      "@repo/presentation-hooks": ["../../packages/presentation/hooks/dist"],
      "@repo/presentation-hooks/*": ["../../packages/presentation/hooks/dist/*"],
      "@repo/capabilities-identity": ["../../capabilities/identity/implementation/index.ts"],
      "@repo/capabilities-identity/*": ["../../capabilities/identity/implementation/*"],
      "@repo/capabilities-requirement-management": ["../../capabilities/requirement-management/implementation/index.ts"],
      "@repo/capabilities-requirement-management/*": ["../../capabilities/requirement-management/implementation/*"],
      "@repo/presentation-experience": ["../../packages/presentation/experience/src/index.ts"],
      "@repo/presentation-experience/*": ["../../packages/presentation/experience/src/*"],
      "@repo/presentation-ui-system": ["../../packages/presentation/ui-system/dist"],
      "@repo/presentation-ui-system/*": ["../../packages/presentation/ui-system/dist/*"],
      "@repo/composition": ["../../packages/composition/dist"],
      "@repo/composition/navigation": ["../../packages/composition/dist/navigation/index.js"],
      "@repo/composition/*": ["../../packages/composition/dist/*"],
      "@repo/presentation-features": ["../../packages/presentation/features/dist"],
      "@repo/presentation-features/ai": ["../../packages/presentation/features/dist/ai/index.js"],
      "@repo/presentation-features/work": ["../../packages/presentation/features/dist/work/index.js"],
      "@repo/presentation-features/reality": ["../../packages/presentation/features/dist/reality/index.js"],
      "@repo/presentation-widgets": ["../../packages/presentation/widgets/dist"],
      "@repo/presentation-widgets/*": ["../../packages/presentation/widgets/dist/*"],
      "@repo/presentation-templates": ["../../packages/presentation/templates/dist"],
      "@repo/presentation-templates/*": ["../../packages/presentation/templates/dist/*"],
      "@repo/presentation-templates/authentication": ["../../packages/presentation/templates/dist/authentication-template"],
      "@repo/capabilities-shared/*": ["../../capabilities/shared/implementation/*"],
      "@repo/capabilities-communication/*": ["../../capabilities/communication/implementation/*"],
      "@repo/capabilities-legal-case/*": ["../../capabilities/legal-case/implementation/*"],
      "@repo/capabilities-work-core/*": ["../../capabilities/work-core/implementation/*"],
      "@repo/core-kernel": ["../../packages/core/kernel/dist"],
      "@repo/core-kernel/*": ["../../packages/core/kernel/dist/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../packages/presentation/experience/src/**/*.ts",
    "../../packages/presentation/experience/src/**/*.tsx",
    "../../packages/presentation/templates/src/**/*.ts",
    "../../packages/presentation/templates/src/**/*.tsx",
    "../../capabilities/**/*.ts",
    "../../capabilities/**/*.tsx",
    "../../packages/core/**/*.ts",
    "../../packages/core/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}