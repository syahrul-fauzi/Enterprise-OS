{
  "extends": "../../config/typescript/nextjs.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "outDir": ".next",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "paths": {
      "@/*": ["./*"],
      // Core-only paths (removed all presentation/UI packages for API standalone)
      "@repo/contracts-core": ["../../packages/contracts-core/src"],
      "@repo/contracts-core/*": ["../../packages/contracts-core/src/*"],
      "@repo/core-kernel": ["../../packages/core/kernel/src"],
      "@repo/core-kernel/*": ["../../packages/core/kernel/src/*"],
      "@repo/core-runtime": ["../../packages/core/runtime/src"],
      "@repo/core-runtime/*": ["../../packages/core/runtime/src/*"],
      "@repo/core-capability-registry": ["../../packages/core/capability-registry/src"],
      "@repo/core-capability-registry/*": ["../../packages/core/capability-registry/src/*"],
      "@repo/composition": ["../../packages/composition/src"],
      "@repo/composition/*": ["../../packages/composition/src/*"],
      "@capabilities/identity": ["../../capabilities/identity/index.ts"],
      "@capabilities/identity/*": ["../../capabilities/identity/*"],
      "@capabilities/identity/implementation/*": ["../../capabilities/identity/implementation/*"],
      "@capabilities/shared/*": ["../../capabilities/shared/implementation/*"],
      "@capabilities/communication/*": ["../../capabilities/communication/implementation/*"],
      "@capabilities/legal-case/*": ["../../capabilities/legal-case/implementation/*"],
      "@capabilities/work-core/*": ["../../capabilities/work-core/*"],
      "@capabilities/governance-evidence/*": ["../../capabilities/governance-evidence/*"],
      "@capabilities/governance-authorization/*": ["../../capabilities/governance-authorization/implementation/*"],
      "@capabilities/atomic-composition/*": ["../../capabilities/atomic-composition/implementation/*"],
      "@capabilities/consultation/*": ["../../capabilities/consultation/implementation/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.js",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": ["node_modules", ".next"]
}