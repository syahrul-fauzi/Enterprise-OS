{
  "extends": "../../config/typescript/nextjs.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      // Core-only paths (removed all presentation/UI packages for API standalone)
      "@repo/core-kernel": ["../../packages/core/kernel/dist"],
      "@repo/core-kernel/*": ["../../packages/core/kernel/dist/*"],
      "@repo/core-runtime": ["../../packages/core/runtime/dist"],
      "@repo/core-runtime/*": ["../../packages/core/runtime/dist/*"],
      "@repo/core-runtime/src/*": ["../../packages/core/runtime/dist/src/*"],
      "@repo/core-runtime/execution-status.js": ["../../packages/core/runtime/dist/src/execution-status.js"],
      "@repo/core-capability-registry": ["../../packages/core/capability-registry/dist"],
      "@repo/core-capability-registry/*": ["../../packages/core/capability-registry/dist/*"],
      "@repo/composition": ["../../packages/composition/dist"],
      "@repo/composition/*": ["../../packages/composition/dist/*"],
      "@repo/capabilities-identity": ["../../capabilities/identity/implementation/index.ts"],
      "@repo/capabilities-identity/*": ["../../capabilities/identity/implementation/*"],
      "@repo/capabilities-identity/repositories": ["../../capabilities/identity/implementation/repositories/index.ts"],
      "@capabilities/shared/*": ["../../capabilities/shared/implementation/*"],
      "@capabilities/communication/*": ["../../capabilities/communication/implementation/*"],
      "@capabilities/legal-case/*": ["../../capabilities/legal-case/implementation/*"],
      "@capabilities/atomic-composition/*": ["../../capabilities/atomic-composition/implementation/*"],
      "@capabilities/consultation/*": ["../../capabilities/consultation/implementation/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.js",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": ["node_modules"]
}