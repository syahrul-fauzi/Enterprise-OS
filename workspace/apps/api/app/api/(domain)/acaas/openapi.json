{"openapi": "3.0.0", "info": {"title": "EOS ACaaS Compliance API", "description": "Autonomous Agentic Compliance-as-a-Service API for document/transaction verification", "version": "0.1.0"}, "servers": [{"url": "https://api.eos.io", "description": "Production server"}], "paths": {"/api/v1/acaas/compliance-check/create": {"post": {"tags": ["acaas-compliance"], "summary": "Create new compliance check", "description": "Initiate a new compliance verification for a document or transaction", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateComplianceCheckRequest"}}}}, "responses": {"200": {"description": "Compliance check created successfully", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateComplianceCheckResponse"}}}, "401": {"description": "Unauthorized - Missing or invalid session"}, "400": {"description": "Bad request - Invalid input parameters"}}}}, "/api/v1/acaas/compliance-check/{id}": {"get": {"tags": ["acaas-compliance"], "summary": "Get compliance check results", "description": "Retrieve the results of an existing compliance check", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}, "description": "Unique ID of the compliance check"}], "responses": {"200": {"description": "Compliance check results retrieved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GetComplianceCheckResponse"}}}, "404": {"description": "Compliance check not found"}, "401": {"description": "Unauthorized - Missing or invalid session"}}}}, "/api/v1/acaas/compliance-check/{id}/update": {"post": {"tags": ["acaas-compliance"], "summary": "Update compliance check status", "description": "Update the status of an existing compliance check (PROCESSING → COMPLETED → FAILED)", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}, "description": "Unique ID of the compliance check"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateComplianceCheckRequest"}}}}, "responses": {"200": {"description": "Compliance check status updated successfully", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateComplianceCheckResponse"}}}, "400": {"description": "Bad request - Invalid status transition or parameters"}, "401": {"description": "Unauthorized - Missing or invalid session"}}}}}, "components": {"schemas": {"CreateComplianceCheckRequest": {"type": "object", "required": ["documentType", "documentData", "compliancePolicies"], "properties": {"documentType": {"type": "string", "description": "Type of document to check (invoice, contract, transaction, etc.)"}, "documentData": {"type": "object", "description": "JSON data of the document to verify"}, "compliancePolicies": {"type": "array", "items": {"type": "string"}, "description": "List of compliance policy IDs to apply"}, "externalId": {"type": "string", "description": "Optional external ID for idempotency"}}}, "CreateComplianceCheckResponse": {"type": "object", "properties": {"success": {"type": "boolean"}, "data": {"type": "object", "properties": {"complianceCheckId": {"type": "string", "format": "uuid"}}, "graphMetadata": {"type": "object", "properties": {"tenantId": {"type": "string"}, "workspaceId": {"type": "string"}, "timestamp": {"type": "string", "format": "date-time"}}}}, "GetComplianceCheckResponse": {"type": "object", "properties": {"success": {"type": "boolean"}, "data": {"type": "object", "properties": {"id": {"type": "string", "format": "uuid"}, "status": {"type": "string", "enum": ["PENDING", "PROCESSING", "COMPLETED", "FAILED"]}, "results": {"type": "array", "items": {"type": "object", "properties": {"policyId": {"type": "string"}, "passed": {"type": "boolean"}, "details": {"type": "string"}}, "failureReason": {"type": "string"}}, "graphMetadata": {"type": "object", "properties": {"tenantId": {"type": "string"}, "workspaceId": {"type": "string"}, "timestamp": {"type": "string", "format": "date-time"}}}}, "UpdateComplianceCheckRequest": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string", "enum": ["PROCESSING", "COMPLETED", "FAILED"]}, "results": {"type": "array", "items": {"type": "object", "properties": {"policyId": {"type": "string"}, "passed": {"type": "boolean"}, "details": {"type": "string"}}, "failureReason": {"type": "string", "description": "Required if status is FAILED"}}, "UpdateComplianceCheckResponse": {"type": "object", "properties": {"success": {"type": "boolean"}, "data": {"type": "object", "properties": {"updatedStatus": {"type": "string"}}, "graphMetadata": {"type": "object", "properties": {"tenantId": {"type": "string"}, "workspaceId": {"type": "string"}, "timestamp": {"type": "string", "format": "date-time"}}}}}}}