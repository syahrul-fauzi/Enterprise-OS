FROM node:22-alpine

WORKDIR /app

ENV CI=1
ENV NEXT_TELEMETRY_DISABLED=1
ENV PNPM_MINIMUM_RELEASE_AGE=0

RUN corepack enable

# Install Python dan build tools untuk kompilasi dependency native
RUN apk add --no-cache python3 py3-pip make gcc g++
# Link python3 ke python untuk node-gyp
RUN ln -sf /usr/bin/python3 /usr/bin/python

# Build context HARUS dijalankan dari root workspace: docker build -f apps/api/Dockerfile.prod .
COPY . .

# Install dependencies with policy disabled via inline config flag
RUN pnpm --config.minimumReleaseAge=0 install --no-frozen-lockfile --no-optional

# Build apps/api (Core Fabric) sebagai container terpisah
WORKDIR /app/apps/api
RUN pnpm --config.minimumReleaseAge=0 next build

EXPOSE 3001

CMD ["pnpm", "start:standalone"]