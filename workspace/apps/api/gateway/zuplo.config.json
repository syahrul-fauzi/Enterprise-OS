{"version": "1.0", "name": "ACaaS Pilot Gateway", "description": "Zuplo gateway configuration for Autonomous Agentic Compliance-as-a-Service pilot", "routes": [{"source": "/api/v1/acaas/:path*", "destination": "https://staging.eos-api.io/api/:path*", "methods": ["GET", "POST"], "auth": {"required": true, "multiple": ["apiKey", "jwt"], "jwt": {"issuer": "eos-identity-core", "audience": "acaas-pilot"}, "apiKey": {"header": "Authorization", "prefix": "Bearer "}}, "rate_limit": {"requests": 50, "period": "60s", "key": "tenantId", "extractKeyFrom": "context.auth.tenantId"}, "tags": ["acaas", "compliance", "pilot", "staging"]}], "openapi": {"title": "EOS ACaaS Compliance API", "description": "Autonomous Agentic Compliance-as-a-Service API for document/transaction verification", "version": "0.1.0", "tags": [{"name": "acaas-compliance", "description": "ACaaS-specific compliance check endpoints"}, {"name": "acaas-metering", "description": "Usage metering and billing endpoints"}]}, "upstreams": [{"name": "eos-api-platform-staging", "url": "https://staging.eos-api.io", "description": "Staging EOS api-platform upstream"}]}