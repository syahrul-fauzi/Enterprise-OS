{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["EOS_CONSTITUTION_ATTESTATION_PROFILE"],
  "concurrency": "24",
  "tasks": {
    "arch-check": {
      "inputs": ["$TURBO_DEFAULT$"],
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint", "^arch-check"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "build": {
      "dependsOn": ["^build", "^arch-check"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/standalone/**", ".next/static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}