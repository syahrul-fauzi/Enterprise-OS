# Local default uses Caddy internal TLS so staging can be verified without
# public DNS or ACME. On VPS staging, replace with a real operator email to
# enable ACME, for example: ops@your-domain.tld
CADDY_TLS=internal

SERVICES_ID_DOMAIN=services-id.com
LAWYERSHUB_DOMAIN=lawyershub.id
ILC_DOMAIN=indonesialawyersclub.id
ACADEMIC_DOMAIN=academic.local

STAGING_HTTP_PORT=80
STAGING_HTTPS_PORT=443

# Durable state for requirement facts and delivery evidence is mounted via the
# staging web container's /data volume. No secret is required for this path.

# Local rail proof base URL (host-header routing through Caddy)
STAGING_CHECK_BASE_URL=http://127.0.0.1:80

# Public acceptance URL once DNS + TLS are active
STAGING_ACCEPTANCE_BASE_URL=https://lawyershub.id
STAGING_ACCEPTANCE_PRODUCT_ID=lawyershub

# Set to 1 on VPS when DNS should already resolve and TLS should already work.
STAGING_REQUIRE_PUBLIC_TLS=0

# Set to 1 for local/internal/self-signed TLS verification.
STAGING_TLS_INSECURE=1