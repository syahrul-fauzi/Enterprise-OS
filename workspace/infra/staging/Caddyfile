# HTTP -> HTTPS Redirect ditangani oleh Cloudflare Tunnel (Origin SSL + Always Use HTTPS)
# Hanya listen on HTTP untuk healthcheck saja
http://localhost:80 {
	handle /api/health {
		respond 200 "OK"
	}
}

