{
	admin off
	log {
		output stdout
		format console
		level INFO
	}
	auto_https off
}

# Konfigurasi asli yang pernah berjalan: Akses localhost HTTP, domain publik dengan TLS internal
http://localhost {
	reverse_proxy web:3000 {
		# HAPUS SEMUA X-EOS-* headers dari client sebelum overwrites
		header_down -X-EOS-Tenant-Subdomain
		header_down -X-EOS-Is-White-Label
		header_down -X-EOS-Tenant-ID
		header_down -X-EOS-Tenant-Brand-Name

		header_up Host {host}
		# Bersihkan headers upstream juga
		header_up -X-EOS-Tenant-Subdomain
		header_up -X-EOS-Is-White-Label
		header_up -X-EOS-Tenant-ID
		header_up -X-EOS-Tenant-Brand-Name
	}
}

# WILDCARD SUBDOMAIN SUPPORT untuk multi-tenant: semua subdomain
# LawyersHub family (production ACME TLS)
https://*.lawyershub.id, https://*.academic.lawyershub.id, https://*.commsme.lawyershub.id {
	tls ops@lawyershub.id
	reverse_proxy web:3000 {
		# HAPUS SEMUA X-EOS-* headers dari client (PREVENT SPOOFING)
		header_up -X-EOS-Tenant-Subdomain
		header_up -X-EOS-Is-White-Label
		header_up -X-EOS-Tenant-ID
		header_up -X-EOS-Tenant-Brand-Name

		header_up Host {host}
		# SET TRUSTED HEADER - hanya Caddy yang boleh set ini
		header_up X-EOS-Tenant-Subdomain {labels.0}
	}
}

# Services-ID family (production ACME TLS for LawyersHub primary deployment)
https://*.services-id.com {
	tls ops@lawyershub.id
	reverse_proxy web:3000 {
		# HAPUS SEMUA X-EOS-* headers dari client (PREVENT SPOOFING)
		header_up -X-EOS-Tenant-Subdomain
		header_up -X-EOS-Is-White-Label
		header_up -X-EOS-Tenant-ID
		header_up -X-EOS-Tenant-Brand-Name

		header_up Host {host}
		# SET TRUSTED HEADER - hanya Caddy yang boleh set ini
		header_up X-EOS-Tenant-Subdomain {labels.0}
	}
}

# MAIN DOMAINS (root domains tanpa subdomain - WHITE LABEL APEX)
# LawyersHub apex (production ACME TLS)
https://lawyershub.id {
	tls ops@lawyershub.id
	reverse_proxy web:3000 {
		# HAPUS SEMUA X-EOS-* headers dari client (PREVENT SPOOFING)
		header_up -X-EOS-Tenant-Subdomain
		header_up -X-EOS-Is-White-Label
		header_up -X-EOS-Tenant-ID
		header_up -X-EOS-Tenant-Brand-Name

		header_up Host {host}
		# SET TRUSTED HEADER - hanya Caddy yang boleh set ini
		header_up X-EOS-Is-White-Label "true"
	}
}

