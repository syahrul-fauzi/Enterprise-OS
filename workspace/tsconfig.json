{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@repo/eos-cli": ["./packages/tooling/eos-cli/src/index.ts"],
      "@repo/eos-cli/*": ["./packages/tooling/eos-cli/src/*"],
      "@repo/tooling-eos-cli": ["./packages/tooling/eos-cli/src/index.ts"],
      "@repo/tooling-eos-cli/*": ["./packages/tooling/eos-cli/src/*"],
      "@repo/core-runtime": ["./packages/core/runtime/src/index.ts"],
      "@repo/core-runtime/*": ["./packages/core/runtime/src/*"],
      "@repo/core-kernel": ["./packages/core/kernel/src/index.ts"],
      "@repo/core-kernel/*": ["./packages/core/kernel/src/*"],
      "@repo/core-constitution": ["./packages/core/constitution/src/index.ts"],
      "@repo/core-constitution/*": ["./packages/core/constitution/src/*"],
      "@repo/core-capability-registry": ["./packages/core/capability-registry/src/index.ts"],
      "@repo/core-capability-registry/*": ["./packages/core/capability-registry/src/*"],
      "@repo/core-registry-resolver": ["./packages/core/registry-resolver/src/index.ts"],
      "@repo/core-registry-resolver/*": ["./packages/core/registry-resolver/src/*"],
      "@repo/core-proof-ledger": ["./packages/core/proof-ledger/src/index.ts"],
      "@repo/core-proof-ledger/*": ["./packages/core/proof-ledger/src/*"],
      "@repo/core-predicate-registry": ["./packages/core/predicate-registry/src/index.ts"],
      "@repo/core-predicate-registry/*": ["./packages/core/predicate-registry/src/*"],
      "@repo/core-transformation-registry": ["./packages/core/transformation-registry/src/index.ts"],
      "@repo/core-transformation-registry/*": ["./packages/core/transformation-registry/src/*"],
      "@repo/core-eir": ["./packages/core/eir/src/index.ts"],
      "@repo/core-eir/*": ["./packages/core/eir/src/*"],
      "@repo/composition": ["./packages/composition/src/index.ts"],
      "@repo/presentation-types": ["./packages/presentation/presentation-types/src/index.ts"],
      "@repo/presentation-foundation": ["./packages/presentation/foundation/src/index.ts"],
      "@repo/presentation-ui-system": ["./packages/presentation/ui-system/src/index.ts"],
      "@repo/presentation-experience": ["./packages/presentation/experience/src/index.ts"],
      "@repo/tooling-arch-tests": ["./packages/tooling/arch-tests/src/index.ts"],
      "@repo/tooling-t001-standalone": ["./packages/tooling/t001-standalone/src/index.ts"],
      "@repo/composition-legal-workspace": ["./packages/compositions/legal-workspace/src/index.ts"],
      "@repo/*": ["./packages/*"],
      "@repo/contracts-core": ["./packages/contracts-core/dist/index.js"],
      "@capabilities/*": ["./capabilities/*"],
      "@repo/capabilities/*": ["./capabilities/*"],
      "@smace/*": ["./products/smace/*"],
      "@smace/contracts": ["./products/smace/contracts/*"],
      "@smace/runtime": ["./products/smace/runtime/*"],
      "@smace/providers": ["./products/smace/providers/*"],
      "@smace/quality": ["./products/smace/quality/*"],
      "@smace/provenance": ["./products/smace/provenance/*"],
      "@smace/commercial": ["./products/smace/commercial/*"],
      "@smace/delivery": ["./products/smace/delivery/*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": ["node_modules", "dist", "out"]
}