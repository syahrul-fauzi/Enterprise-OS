{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@repo/*": ["./packages/*"],
      "@capabilities/*": ["./capabilities/*"]
    }
  },
  "exclude": ["node_modules", "dist", "out"]
}