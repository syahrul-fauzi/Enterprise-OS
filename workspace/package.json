{
  "name": "eos",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "arch-check": "turbo run arch-check",
    "arch-test": "turbo run arch-check",
    "gate": "turbo run arch-check lint check-types build",
    "governance:gate": "pnpm check-types && pnpm eos verify-foundation && pnpm eos verify-capability-registry && pnpm eos gate-c refresh-status",
    "status": "node --import tsx ./packages/tooling/eos-cli/src/index.ts status",
    "eos": "node --import tsx ./packages/tooling/eos-cli/src/index.ts",
    "staging:up": "bash ./scripts/staging-up.sh",
    "staging:down": "bash ./scripts/staging-down.sh",
    "staging:check": "bash ./scripts/staging-check.sh",
    "staging:convergence": "node ./scripts/public-convergence-check.mjs",
    "staging:gate6-proof": "node --import tsx ./scripts/staging-gate6-proof.ts",
    "verify:genesis-baseline": "pnpm eos gate-c verify-genesis-baseline",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "dependencies": {
    "@types/pg": "^8.21.0",
    "pg": "^8.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^16.2.0",
    "@playwright/test": "^1.62.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.6.0",
    "globals": "^16.5.0",
    "js-yaml": "^5.2.3",
    "node-fetch": "^3.3.2",
    "playwright": "^1.62.1",
    "postcss": "^8.5.3",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "react": "^19.2.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.5",
    "tsx": "^4.23.1",
    "turbo": "^2.10.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=18"
  }
}