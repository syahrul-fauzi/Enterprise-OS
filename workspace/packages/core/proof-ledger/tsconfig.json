{
  "extends": "../../../config/typescript/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictNullChecks": true,
    "declaration": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "@repo/*": ["../../*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "build", "node_modules", "tests"]
}