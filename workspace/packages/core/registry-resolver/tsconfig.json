{
  "extends": "../../../config/typescript/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictNullChecks": true,
    "declaration": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "paths": {
      "@repo/core-transformation-registry": ["../transformation-registry/src"],
      "@repo/core-predicate-registry": ["../predicate-registry/src"]
    }
  },
  "references": [
    { "path": "../eir/tsconfig.json" },
    { "path": "../predicate-registry/tsconfig.json" },
    { "path": "../transformation-registry/tsconfig.json" }
  ],
  "include": ["src", "src/yaml.d.ts"],
  "exclude": ["dist", "build", "node_modules", "tests"]
}