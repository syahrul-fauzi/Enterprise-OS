{
  "extends": "../../../config/typescript/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictNullChecks": true,
    "declaration": true,
    "incremental": true,
    "composite": true,

    "noEmit": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "types": ["node"],
    "ignoreDeprecations": "5.0"
  },
  "include": ["src"],
  "exclude": ["dist", "build", "node_modules"]
}