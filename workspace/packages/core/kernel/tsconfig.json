{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictNullChecks": true,
    "declaration": true,
    "ignoreDeprecations": "5.0",
    "composite": false,
    "incremental": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "build", "node_modules", "../../capabilities/**/*"]
}