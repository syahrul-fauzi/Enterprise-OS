{
  "extends": "@repo/config-typescript/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictNullChecks": true,
    "declaration": true,
    "incremental": true,
    "composite": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "rootDir": "./src",
    "paths": {
      "@capabilities/*": ["../../../capabilities/*"]
    }
  },
  "references": [
    { "path": "../../../capabilities/identity/tsconfig.json" },
    { "path": "../../../capabilities/observability/tsconfig.json" },
    { "path": "../../../capabilities/legal-case/tsconfig.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "build", "node_modules"]
}