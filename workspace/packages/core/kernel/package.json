{
  "name": "@repo/core-kernel",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./digest-engine": {
      "types": "./dist/digest-engine.d.ts",
      "default": "./dist/digest-engine.js"
    },
    "./digest-engine.js": {
      "types": "./dist/digest-engine.d.ts",
      "default": "./dist/digest-engine.js"
    },
    "./session/workspace-session": {
      "types": "./dist/session/workspace-session.d.ts",
      "default": "./dist/session/workspace-session.js"
    },
    "./registry/capability-command-registry": {
      "types": "./dist/registry/capability-command-registry.d.ts",
      "default": "./dist/registry/capability-command-registry.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@repo/core-runtime": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@types/node": "^22.15.30",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}