{
  "extends": "../../../config/typescript/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictNullChecks": false,
    "declaration": true,
    "incremental": true,
    "skipLibCheck": true,
    "noEmit": false,
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "**/*.d.ts", "dist"]
}