{
  "extends": "@repo/config-typescript/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "ignoreDeprecations": "6.0",
    "types": ["node", "react"],
    "typeRoots": ["./node_modules/@types", "/root/Enterprise-OS/workspace/node_modules/@types"],
    "paths": {
      "@repo/core-kernel": ["../../core/kernel/src/index.ts"],
      "@repo/core-kernel/*": ["../../core/kernel/src/*"],
      "@repo/core-runtime": ["../../core/runtime/src/index.ts"],
      "@repo/core-runtime/*": ["../../core/runtime/src/*"],
      "@repo/composition": ["../../composition/src/index.ts"],
      "@repo/composition/*": ["../../composition/src/*"],
      "@repo/core-capability-registry": ["../../core/capability-registry/src/index.ts"],
      "@repo/core-capability-registry/*": ["../../core/capability-registry/src/*"],
      "@repo/presentation-ui-system": ["../ui-system/src/index.ts"],
      "@repo/presentation-ui-system/*": ["../ui-system/src/*"],
      "@repo/presentation-entities": ["../entities/src/index.ts"],
      "@repo/presentation-entities/*": ["../entities/src/*"],
      "@repo/presentation-foundation": ["../foundation/src/index.ts"],
      "@repo/presentation-foundation/*": ["../foundation/src/*"],
      "@repo/presentation-widgets": ["../widgets/src/index.ts"],
      "@repo/presentation-widgets/*": ["../widgets/src/*"],
      "@repo/presentation-experience": ["../experience/src/index.ts"],
      "@repo/presentation-experience/*": ["../experience/src/*"],
      "@repo/presentation-hooks": ["../hooks/src/index.ts"],
      "@repo/presentation-hooks/*": ["../hooks/src/*"],
      "@repo/presentation-templates": ["../templates/src/index.ts"],
      "@repo/presentation-templates/*": ["../templates/src/*"],
      "@repo/presentation-pages": ["../pages/src/index.ts"],
      "@repo/presentation-pages/*": ["../pages/src/*"],
      "@repo/presentation-config": ["../config/src/index.ts"],
      "@repo/presentation-config/*": ["../config/src/*"],
      "@products/*": ["../../../products/*"],
      "@procedures/*": ["../../../procedures/*"],
      "@capabilities/*": ["../../../capabilities/*"],
      "@repo/capabilities/*": ["../../../capabilities/*"],
      "next/link": ["/root/Enterprise-OS/workspace/apps/web/node_modules/next/dist/client/app-dir/link.d.ts"],
      "next/navigation": ["/root/Enterprise-OS/workspace/apps/web/node_modules/next/dist/client/components/navigation.d.ts"]
    }
  },
  "include": ["src/**/*", "./**/*.ts", "./**/*.tsx"],
  "references": [
    { "path": "../config" },
    { "path": "../entities" }
  ],
  "exclude": ["node_modules", "dist"]
}