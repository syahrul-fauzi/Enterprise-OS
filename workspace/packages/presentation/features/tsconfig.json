{
  "extends": "@repo/config-typescript/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "composite": true,
    "incremental": true,
    "types": ["node", "react"],
    "typeRoots": ["./node_modules/@types", "/root/Enterprise-OS/workspace/node_modules/@types"],
    "paths": {
      "@repo/core-kernel": ["../../core/kernel/dist"],
      "@repo/core-kernel/*": ["../../core/kernel/dist/*"],
      "@repo/core-runtime": ["../../core/runtime/dist"],
      "@repo/core-runtime/*": ["../../core/runtime/dist/*"],
      "@repo/composition": ["../../composition/dist"],
      "@repo/composition/*": ["../../composition/dist/*"],
      "@repo/core-capability-registry": ["../../core/capability-registry/dist"],
      "@repo/core-capability-registry/*": ["../../core/capability-registry/dist/*"],
      "@repo/presentation-ui-system": ["../ui-system/dist"],
      "@repo/presentation-ui-system/*": ["../ui-system/dist/*"],
      "@repo/presentation-entities": ["../entities/dist"],
      "@repo/presentation-entities/*": ["../entities/dist/*"],
      "@repo/presentation-foundation": ["../foundation/dist"],
      "@repo/presentation-foundation/*": ["../foundation/dist/*"],
      "@repo/presentation-widgets": ["../widgets/dist"],
      "@repo/presentation-widgets/*": ["../widgets/dist/*"],
      "@repo/presentation-hooks": ["../hooks/dist"],
      "@repo/presentation-hooks/*": ["../hooks/dist/*"],
      "@repo/presentation-templates": ["../templates/dist"],
      "@repo/presentation-templates/*": ["../templates/dist/*"],
      "@repo/presentation-pages": ["../pages/dist"],
      "@repo/presentation-pages/*": ["../pages/dist/*"],
      "@repo/presentation-config": ["../config/dist"],
      "@repo/presentation-config/*": ["../config/dist/*"],
      "@products/*": ["../../../products/*/dist"],
      "@procedures/*": ["../../../procedures/*/dist"],
      "@capabilities/*": ["../../../capabilities/*/dist"],
      "@repo/capabilities/*": ["../../../capabilities/*/dist"]
    }
  },
  "include": ["src/**/*", "src/index.ts"],
  "references": [],
  "exclude": ["node_modules", "dist"]
}