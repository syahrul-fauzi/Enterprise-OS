{
  "name": "@repo/presentation-experience",
  "version": "0.1.0",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc --skipLibCheck",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@repo/core-kernel": "workspace:*",
    "@repo/presentation-entities": "workspace:*",
    "@repo/presentation-features": "workspace:*",
    "@repo/presentation-hooks": "workspace:*",
    "@repo/presentation-ui-system": "workspace:*",
    "lucide-react": "^1.45.0",
    "next": "14.2.0"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}