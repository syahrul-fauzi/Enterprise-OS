{
  "compilerOptions": {
    "outDir": "./dist",
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "sourceMap": false,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "lib": ["ES2020", "DOM"],
    "typeRoots": ["node_modules/@types"]
  },
  "include": [
    "src/academic.ts",
    "src/lawyershub.ts",
    "src/ilc.ts",
    "src/services-id.ts"
  ]
}
