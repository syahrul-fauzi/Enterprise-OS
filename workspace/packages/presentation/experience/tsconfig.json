{
  "extends": "../../../config/typescript/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "composite": true,
    "incremental": true,
    "jsx": "react-jsx",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@repo/presentation-config": [
        "../config/dist"
      ],
      "@repo/presentation-entities": [
        "../entities/dist/src"
      ],
      "@repo/presentation-pages": [
        "../pages/dist/src"
      ],
      "@products/*": [
        "../../../products/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    {
      "path": "../config"
    },
    {
      "path": "../entities"
    },
    {
      "path": "../pages"
    },
    {
      "path": "../../../products/academic"
    },
    {
      "path": "../../../products/lawyershub"
    },
    {
      "path": "../../../products/services-id"
    }
  ]
}