{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "build:styles"],
      "outputs": ["dist/**"]
    },
    "build:styles": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "with": ["dev:styles", "dev:components"]
    },
    "dev:styles": {
      "cache": false,
      "persistent": true
    },
    "dev:components": {
      "cache": false,
      "persistent": true
    }
  }
}