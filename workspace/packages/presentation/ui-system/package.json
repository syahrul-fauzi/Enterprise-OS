{
  "name": "@repo/presentation-ui-system",
  "version": "0.1.0-alpha.4",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./styles.css": "./dist/index.css",
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./layouts": {
      "import": "./dist/src/layouts/index.js",
      "types": "./dist/src/layouts/index.d.ts"
    },
    "./molecules": {
      "import": "./dist/src/molecules/index.js",
      "types": "./dist/src/molecules/index.d.ts"
    },
    "./organisms": {
      "import": "./dist/src/organisms/index.js",
      "types": "./dist/src/organisms/index.d.ts"
    },
    "./patterns": {
      "import": "./dist/src/patterns/index.js",
      "types": "./dist/src/patterns/index.d.ts"
    },
    "./atoms": {
      "import": "./dist/src/atoms/index.js",
      "types": "./dist/src/atoms/index.d.ts"
    },
    "./atoms/button": {
      "import": "./dist/src/atoms/button.js",
      "types": "./dist/src/atoms/button.d.ts"
    },
    "./atoms/input": {
      "import": "./dist/src/atoms/input.js",
      "types": "./dist/src/atoms/input.d.ts"
    },
    "./atoms/card": {
      "import": "./dist/src/atoms/card.js",
      "types": "./dist/src/atoms/card.d.ts"
    },
    "./components/page-header": {
      "import": "./dist/src/components/page-header/index.js",
      "types": "./dist/src/components/page-header/index.d.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm run build:styles && tsc",
    "build:styles": "pnpm exec tailwindcss -i ./src/styles.css -o ./dist/index.css --config ../../../apps/web/tailwind.config.js",
    "check-types": "tsc --noEmit",
    "dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
    "dev:components": "tsc --watch",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@repo/presentation-foundation": "workspace:*",
    "@repo/presentation-hooks": "workspace:*"
  },
  "peerDependencies": {
    "next": "^14.2.8",
    "react": "^19"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "@repo/config-tailwind": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.1.0",
    "eslint": "^9.39.1",
    "tailwindcss": "^4.1.5",
    "typescript": "5.9.2"
  }
}