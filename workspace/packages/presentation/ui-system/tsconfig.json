{
  "extends": "@repo/config-typescript/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictNullChecks": false,
    "declaration": true,
    "composite": false,
    "noEmitOnError": true,
    "emitDeclarationOnly": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "build", "node_modules"]
}