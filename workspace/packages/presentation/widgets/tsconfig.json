{
  "extends": "@repo/config-typescript/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./src",
    "strictNullChecks": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "jsx": "react-jsx",
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "composite": true,
    "incremental": true,
    "paths": {
      "*": ["./*"],
      "@repo/core-kernel": ["../../core/kernel/dist"],
      "@repo/core-kernel/*": ["../../core/kernel/dist/*"],
      "@repo/core-runtime": ["../../core/runtime/dist"],
      "@repo/core-runtime/*": ["../../core/runtime/dist/*"],
      "@repo/composition": ["../../composition/dist"],
      "@repo/composition/*": ["../../composition/dist/*"],
      "@repo/core-capability-registry": ["../../core/capability-registry/dist"],
      "@repo/core-capability-registry/*": ["../../core/capability-registry/dist/*"],
      "@repo/presentation-ui-system": ["../ui-system/dist"],
      "@repo/presentation-ui-system/*": ["../ui-system/dist/*"],
      "@repo/presentation-types": ["../presentation-types/dist"],
      "@repo/presentation-types/*": ["../presentation-types/dist/*"],
      "@repo/presentation-foundation": ["../foundation/dist"],
      "@repo/presentation-foundation/*": ["../foundation/dist/*"],
      "@repo/presentation-features": ["../features/dist"],
      "@repo/presentation-features/*": ["../features/dist/*"],
      "@repo/presentation-hooks": ["../hooks/dist"],
      "@repo/presentation-hooks/*": ["../hooks/dist/*"],
      "@repo/presentation-experience": ["../experience/dist"],
      "@repo/presentation-experience/*": ["../experience/dist/*"],
      "@repo/presentation-config": ["../config/dist"],
      "@repo/presentation-config/*": ["../config/dist/*"],
      "@products/*": ["../../../products/*/dist"],
      "@procedures/*": ["../../../procedures/*/dist"],
      "@capabilities/*": ["../../capabilities/*/dist"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "../../../capabilities/**/*", "../../../packages/composition/**/*", "!../../packages/presentation/*"],
  "references": [
    { "path": "../config" }
  ]
}