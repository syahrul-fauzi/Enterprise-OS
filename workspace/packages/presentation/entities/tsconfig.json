{
  "extends": "../../../config/typescript/react.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "skipLibCheck": true,
    "composite": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "build", "node_modules"]
}