{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "strict": true,
    "strictNullChecks": true,
    "declaration": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "ignoreDeprecations": "5.0",
    "baseUrl": "./",
    "rootDirs": ["./src", "../../../capabilities/"],
    "paths": {
      "@repo/core-runtime/work-continuity": ["../../packages/core/runtime/dist/src/work-continuity.js"]
    }
  },
  "references": [
    {"path": "../../../capabilities/agent-orchestration"},
    {"path": "../../../capabilities/api-platform"},
    {"path": "../../../capabilities/communication"},
    {"path": "../../../capabilities/connector-ecosystem"},
    {"path": "../../../capabilities/trust-framework"},
    {"path": "../../../capabilities/work-core"}
  ],
  "include": ["src/**/*", "src/yaml.d.ts"],
  "exclude": ["dist", "build", "node_modules"]
}