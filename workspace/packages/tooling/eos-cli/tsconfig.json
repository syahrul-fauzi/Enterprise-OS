{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "strictNullChecks": true,
    "declaration": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "ignoreDeprecations": "5.0",
    "baseUrl": "./",
    "paths": {
      "@repo/core-capability-registry": ["../../packages/core/capability-registry/dist/src/index.js"]
    }
  },
  "references": [
    {"path": "../../../capabilities/agent-orchestration"},
    {"path": "../../../capabilities/api-platform"}
  ],
  "include": ["src/**/*"],
  "exclude": ["dist", "build", "node_modules"]
}