{
  "extends": "@repo/config-typescript/react-library.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "incremental": false,
    "composite": false,
    "rootDir": "src",
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "paths": {
      "@repo/core-capability-registry": ["../core/capability-registry/dist"]
    }
  },
  "include": ["src/**/*.ts"]
}