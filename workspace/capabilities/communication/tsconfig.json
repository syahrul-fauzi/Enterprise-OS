{
  "extends": "../../config/typescript/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022",
    "paths": {
      "@repo/core-kernel": ["../../packages/core/kernel/dist/src/index.d.ts"],
      "@repo/core-kernel/*": ["../../packages/core/kernel/dist/src/*"],
      "@repo/core-runtime": ["../../packages/core/runtime/dist/src/index.d.ts"],
      "@repo/core-runtime/*": ["../../packages/core/runtime/dist/src/*"],
      "@capabilities/*": ["../../capabilities/*"],
      "@capabilities/work-core": ["../work-core/contracts/work.contracts.ts"],
      "@capabilities/work-core/*": ["../work-core/*"],
      "@capabilities/identity": ["../identity/dist/index.d.ts"],
      "@capabilities/identity/*": ["../identity/dist/*"]
    }
  },
  "include": ["implementation/**/*.ts", "implementation/contracts/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.d.ts"]
}