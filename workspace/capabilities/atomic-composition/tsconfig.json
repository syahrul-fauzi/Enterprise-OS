{
  "extends": "@repo/config-typescript/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "composite": true,
    "noEmit": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "moduleResolution": "NodeNext",
    "types": ["jest", "node"],
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "paths": {
      "@repo/capabilities-identity": ["../identity/implementation/index.ts"],
      "@repo/capabilities-identity/*": ["../identity/implementation/*"],
      "@repo/capabilities-work-core": ["../work-core/contracts/work.contracts.ts"],
      "@repo/capabilities-work-core/*": ["../work-core/*"]
    }
  },
  "references": [
    { "path": "../../packages/core/kernel/tsconfig.json" },
    { "path": "../../packages/core/realtime/tsconfig.json" },
    { "path": "../../packages/core/capability-registry/tsconfig.json" },
    { "path": "../identity/tsconfig.json" },
    { "path": "../work-core/tsconfig.json" },
    { "path": "../governance-evidence/tsconfig.json" },
    { "path": "../legal-case/tsconfig.json" }
  ],
  "include": [
    "implementation/**/*.ts",
    "economic-proof.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../*/**/*",
    "!../identity/**/*",
    "!../work-core/**/*",
    "!../governance-evidence/**/*",
    "!../legal-case/**/*",
    "!../../packages/core/**/*"
  ]
}