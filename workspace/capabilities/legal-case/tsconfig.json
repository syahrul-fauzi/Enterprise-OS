{
  "extends": "../../config/typescript/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "types": ["node"],
    "skipLibCheck": true,
    "composite": true,
    "noEmit": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "emitDeclarationOnly": false,
    "allowImportingTsExtensions": false,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022",
    "paths": {
      "@repo/core-kernel": ["../../packages/core/kernel/dist/index.d.ts", "../../packages/core/kernel/src/index.ts"],
      "@repo/core-kernel/*": ["../../packages/core/kernel/dist/*.d.ts", "../../packages/core/kernel/src/*"],
      "@repo/core-runtime": ["../../packages/core/runtime/dist/index.d.ts", "../../packages/core/runtime/src/index.ts"],
      "@repo/core-realtime": ["../../packages/core/realtime/dist/index.d.ts", "../../packages/core/realtime/src/index.ts"],
      "@repo/capability-identity": ["../../capabilities/identity/dist/index.d.ts", "../../capabilities/identity/src/index.ts"],
      "@repo/capability-shared": ["../../capabilities/shared/dist/index.d.ts", "../../capabilities/shared/src/index.ts"],
      "@repo/capability-work-core": ["../../capabilities/work-core/dist/index.d.ts", "../../capabilities/work-core/src/index.ts"],
      "@repo/capability-legal-case/contracts": ["./contracts/index.ts"],
      "@repo/capability-legal-case/repository": ["./implementation/repository/index.ts"],
      "@repo/capability-identity/repositories/base": ["../identity/implementation/repositories/base.repository.ts"],
      "@repo/capability-identity/repositories": ["../identity/implementation/repositories/index.ts"],
      "@repo/capability-identity/contracts": ["../identity/implementation/contracts/index.ts"] // Force re-check
    }
  },
  "references": [
    { "path": "../../packages/core/kernel/tsconfig.json" },
    { "path": "../../packages/core/realtime/tsconfig.json" },
    { "path": "../identity/tsconfig.json" },
    { "path": "../shared/tsconfig.json" },
    { "path": "../../packages/core/runtime/tsconfig.json" }
  ],
  "include": ["implementation/**/*.ts", "contracts/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.d.ts"]
}