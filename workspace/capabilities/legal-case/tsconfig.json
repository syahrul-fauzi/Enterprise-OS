{
  "extends": "@repo/config-typescript/base.json",
  "compilerOptions": {
    "rootDir": "./implementation",
    "outDir": "./dist",
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "ignoreDeprecations": "5.0",
    "types": ["node"],
    "skipLibCheck": true,
    "composite": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "@repo/core-kernel": ["../../packages/core/kernel/src/index.ts"],
      "@repo/core-kernel/*": ["../../packages/core/kernel/src/*"],
      "@repo/core-capability-registry": ["../../packages/core/capability-registry/src/index.ts"],
      "@repo/core-capability-registry/*": ["../../packages/core/capability-registry/src/*"],
      "@capabilities/identity/*": ["../identity/*"],
      "@capabilities/consultation/*": ["../consultation/*"]
    }
  },
  "references": [
    { "path": "../identity/tsconfig.json" }
  ],
  "include": ["implementation/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.d.ts"]
}