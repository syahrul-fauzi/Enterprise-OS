{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "./dist",
    "strictNullChecks": true,
    "declaration": true,
    "incremental": true,
    "ignoreDeprecations": "5.0",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "composite": true,
    "rootDir": "./"
  },
  "references": [
    {
      "path": "../../packages/core/kernel/tsconfig.json"
    },
    {
      "path": "../identity/tsconfig.json"
    }
  ],
  "include": [
    "implementation/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.d.ts"
  ],
  "extends": "../tsconfig.json"
}
