{
  "extends": "../../config/typescript/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictNullChecks": false,
    "declaration": true,
    "ignoreDeprecations": "5.0",
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "noEmit": false,
    "rootDir": ".",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@repo/core-kernel": ["../../packages/core/kernel/dist/index.d.ts", "../../packages/core/kernel/src/index.ts"],
      "@repo/core-kernel/*": ["../../packages/core/kernel/dist/*.d.ts", "../../packages/core/kernel/src/*"]
    }
  },
  "references": [
    {
      "path": "../../packages/core/kernel/tsconfig.json"
    },
    {
      "path": "../identity/tsconfig.json"
    }
  ],
  "include": ["index.ts", "implementation/**/*.ts"],
  "exclude": ["dist", "build", "node_modules"]
}