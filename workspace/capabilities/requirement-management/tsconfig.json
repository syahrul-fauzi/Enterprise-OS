{
  "extends": "../../config/typescript/base.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "ignoreDeprecations": "5.0",
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022",
    "paths": {
      "@repo/core-runtime": ["../../packages/core/runtime/src"],
      "@repo/capabilities-identity": ["../identity/src"],
      "@capabilities/work-core": ["../work-core/index.ts"],
      "@capabilities/work-core/*": ["../work-core/*"]
    }
  },
  "include": ["implementation/**/*.ts", "contracts/**/*.ts", "repository/**/*.ts", "commands/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.d.ts"]
}