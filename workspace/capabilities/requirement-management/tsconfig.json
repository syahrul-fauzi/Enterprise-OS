{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "./dist",
    "strictNullChecks": true,
    "declaration": true,
    "incremental": true,
    "ignoreDeprecations": "5.0",
    "types": ["node"],
    "skipLibCheck": true,
    "composite": true,
    "rootDir": "./",
    "paths": {
      "*": ["./*"],
      "@repo/core-kernel": ["../../packages/core/kernel/src/index.ts"],
      "@repo/core-kernel/*": ["../../packages/core/kernel/src/*"],
      "@capabilities/identity/*": ["../identity/*"]
    }
  },
  "references": [
    { "path": "../../packages/core/kernel/tsconfig.json" },
    { "path": "../identity/tsconfig.json" }
  ],
  "include": ["implementation/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.d.ts"]
}