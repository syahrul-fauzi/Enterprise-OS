{
  "extends": "../../config/typescript/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "ignoreDeprecations": "5.0",
    "types": ["node"],
    "skipLibCheck": true,
    "composite": true,
    "noEmit": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022",
    "paths": {
      "@repo/core-kernel": ["../../packages/core/kernel/src/index.ts"],
      "@repo/capabilities-identity": ["../identity/implementation/index.ts"],
      "@repo/capabilities-identity/*": ["../identity/implementation/*"],
      "@repo/capabilities-work-core": ["../work-core/contracts/work.contracts.ts"],
      "@repo/capabilities-work-core/*": ["../work-core/*"],
      "@repo/capabilities-reasoning": ["./implementation/contracts/reasoning.contracts.ts"],
      "@repo/capabilities-reasoning/*": ["./*"]
    }
  },
  "references": [
    { "path": "../../packages/core/kernel/tsconfig.json" },
    { "path": "../../packages/core/runtime/tsconfig.json" },
    { "path": "../identity/tsconfig.json" },
    { "path": "../work-core/tsconfig.json" }
  ],
  "include": ["implementation/**/*.ts", "contracts/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.d.ts"]
}