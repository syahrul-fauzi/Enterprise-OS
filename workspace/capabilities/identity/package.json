{
  "name": "@repo/capabilities-identity",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "implementation"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./implementation": "./implementation/index.ts",
    "./implementation/*": "./implementation/*",
    "./repositories": "./implementation/repositories/index.ts",
    "./repositories/base": "./implementation/repositories/base.repository.ts"
  },
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "eslint implementation --max-warnings 0"
  },
  "dependencies": {
    "@repo/contracts-core": "workspace:*",
    "@repo/core-kernel": "workspace:*",
    "jose": "^6.2.17",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@types/node": "^22.15.30",
    "eslint": "^9.39.1",
    "typescript": "5.9.2"
  }
}