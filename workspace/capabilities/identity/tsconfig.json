{
  "extends": "../../config/typescript/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictNullChecks": false,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "5.0",
    "paths": {
      "@repo/*": ["../../packages/*"]
    }
  },
  "references": [
    { "path": "../../packages/core/kernel/tsconfig.json" },
    { "path": "../../packages/core/runtime/tsconfig.json" },
    { "path": "../../packages/contracts-core/tsconfig.json" }
  ],
  "include": ["implementation/**/*.ts", "contracts/**/*.ts"],
  "exclude": ["dist", "build", "node_modules", "**/*.d.ts", "../requirement-management", "../requirements-traceability-matrix"]
}