{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "strictNullChecks": true,
    "declaration": true,
    "incremental": true,
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "composite": true,
    "rootDir": "./"
  },
  "references": [
    {
      "path": "../../packages/core/kernel/tsconfig.json"
    }
  ],
  "include": [
    "implementation/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.d.ts"
  ]
}
