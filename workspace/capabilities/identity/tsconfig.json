{
  "extends": "../../config/typescript/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictNullChecks": false,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "emitDeclarationOnly": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@repo/core-kernel": ["../../packages/core/kernel/dist/src/index.d.ts"],
      "@repo/core-kernel/*": ["../../packages/core/kernel/dist/src/*"],
      "@repo/core-runtime": ["../../packages/core/runtime/dist/src/index.d.ts"],
      "@repo/core-runtime/*": ["../../packages/core/runtime/dist/src/*"],
      "@repo/*": ["../../packages/*"],
      "@capabilities/*": ["../../capabilities/*"]
    }
  },
  "include": ["implementation/**/*.ts", "contracts/**/*.ts"],
  "exclude": ["dist", "build", "node_modules", "**/*.d.ts", "../requirement-management", "../requirements-traceability-matrix"]
}