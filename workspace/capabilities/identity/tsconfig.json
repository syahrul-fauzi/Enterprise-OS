{
  "extends": "../../config/typescript/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "strictNullChecks": true,
    "declaration": true,
    "incremental": true,
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "types": ["node"],
    "skipLibCheck": true,
    "composite": true,
    "rootDir": "./",
    "paths": {
      "@repo/core-kernel": ["../../packages/core/kernel/src/index.ts"],
      "@repo/core-kernel/*": ["../../packages/core/kernel/src/*"],
      "@capabilities/consultation/*": ["../consultation/*"]
    }
  },
  "references": [
    { "path": "../../packages/core/kernel/tsconfig.json" }
  ],
  "include": ["implementation/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.d.ts"]
}