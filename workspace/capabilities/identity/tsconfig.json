{
  "extends": "../../config/typescript/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictNullChecks": false,
    "declaration": true,
    "declarationMap": true,

    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "noEmit": false,
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@repo/core-kernel": ["../../packages/core/kernel/dist"],
      "@repo/core-kernel/*": ["../../packages/core/kernel/dist/*"]
    }
  },
  "references": [
    { "path": "../../packages/core/kernel" }
  ],
  "include": ["index.ts", "implementation/**/*.ts"],
  "exclude": ["dist", "build", "node_modules"]
}