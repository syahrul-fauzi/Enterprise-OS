{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "ignoreDeprecations": "5.0",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "composite": true,
    "rootDir": "./implementation",
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": [
      "es2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022"
  },
  "references": [
    { "path": "../../packages/core/kernel/tsconfig.json" },
    { "path": "../../packages/core/runtime/tsconfig.json" },
    { "path": "../identity/tsconfig.json" },
    { "path": "../legal-case/tsconfig.json" },
    { "path": "../observability/tsconfig.json" },
    { "path": "../shared/tsconfig.json" }
  ],
  "include": [
    "implementation/**/*.ts",
    "__tests__/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.d.ts"
  ]
}