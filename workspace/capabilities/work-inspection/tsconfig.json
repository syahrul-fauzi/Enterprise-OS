{
  "extends": "../../config/typescript/base.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "noEmit": false,
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022",
    "paths": {
      "@repo/capabilities-work-core": ["../work-core/contracts/work.contracts.ts"],
      "@repo/capabilities-work-core/*": ["../work-core/*"]
    }
  },
  "include": [
    "index.ts",
    "implementation/**/*.ts",
    "contracts/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.d.ts",
    "../connector-ecosystem/**/*"
  ]
}