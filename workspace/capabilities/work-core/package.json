{
  "name": "@capabilities/work-core",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./implementation/index.ts",
  "types": "./dist/implementation/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/implementation/index.d.ts",
      "default": "./dist/implementation/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./implementation": "./implementation/index.ts",
    "./implementation/*": "./implementation/*",
    "./contracts": "./contracts/work.contracts.ts",
    "./contracts/work.contracts": "./contracts/work.contracts.ts",
    "./repository/*": "./implementation/repository/*"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/contracts-core": "workspace:*",
    "@repo/core-kernel": "workspace:*"
  },
  "devDependencies": {
    "@repo/config-typescript": "workspace:*",
    "typescript": "^5.9.2"
  }
}