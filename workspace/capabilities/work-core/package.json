{
  "name": "@capabilities/work-core",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./index.ts",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./implementation": "./implementation/index.ts",
    "./implementation/*": "./implementation/*",
    "./contracts": "./contracts/work.contracts.ts",
    "./contracts/work.contracts": "./contracts/work.contracts.ts",
    "./contracts/work.contracts.js": "./contracts/work.contracts.ts",
    "./repository/*": "./implementation/repository/*",
    "./utils/*": "./implementation/utils/*"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "arch-check": "node --import tsx ./scripts/architecture-fitness-checks.ts"
  },
  "dependencies": {
    "@repo/contracts-core": "workspace:*",
    "@repo/core-kernel": "workspace:*",
    "@capabilities/identity": "workspace:*"
  },
  "devDependencies": {
    "@repo/config-typescript": "workspace:*",
    "typescript": "^5.9.2"
  }
}