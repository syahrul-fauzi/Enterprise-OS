{
  "extends": "../../config/typescript/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "emitDeclarationOnly": false,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022",
    "baseUrl": "../..",
    "paths": {
      "@repo/core-kernel": ["packages/core/kernel/dist/src/index.d.ts"],
      "@repo/core-kernel/*": ["packages/core/kernel/dist/src/*"],
      "@repo/core-runtime": ["packages/core/runtime/dist/src/index.d.ts"],
      "@repo/core-runtime/*": ["packages/core/runtime/dist/src/*"]
    }
  },
  "include": ["./implementation/**/*.ts", "./contracts/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.d.ts"]
}