{
  "extends": "../../config/typescript/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "types": ["node"],
    "skipLibCheck": true,
    "composite": true,
    "noEmit": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "emitDeclarationOnly": false,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022",
    "baseUrl": "../..",
    "paths": {
      "@repo/*": ["../../packages/*"],
      "@repo/capabilities-identity": ["../identity/index.ts"],
      "@repo/capabilities-identity/*": ["../identity/*"],
      "@capabilities/*": ["../*"],
      "@repo/shared/*": ["../shared/*"]
    }
  },
  "references": [
    { "path": "../../packages/core/kernel/tsconfig.json" },
    { "path": "../../packages/core/runtime/tsconfig.json" },
    { "path": "../identity/tsconfig.json" },
    { "path": "../shared/tsconfig.json" }
  ],
  "include": ["./index.ts", "./implementation/**/*.ts", "./contracts/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.d.ts"]
}