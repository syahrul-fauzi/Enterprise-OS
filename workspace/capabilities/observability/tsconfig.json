{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "ignoreDeprecations": "5.0",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "composite": true,
    "rootDir": "../",
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": [
      "es2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022"
  },
  "references": [
    {
      "path": "../identity/tsconfig.json"
    },
    {
      "path": "../legal-case/tsconfig.json"
    },
    {
      "path": "../agent-orchestration/tsconfig.json"
    },
    {
      "path": "../api-platform/tsconfig.json"
    },
    {
      "path": "../evidence-registry/tsconfig.json"
    },
    {
      "path": "../requirement-management/tsconfig.json"
    },
    {
      "path": "../requirements-traceability-matrix/tsconfig.json"
    }
  ],
  "include": [
    "implementation/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.d.ts"
  ]
}