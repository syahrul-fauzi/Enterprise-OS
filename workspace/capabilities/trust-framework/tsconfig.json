{
  "extends": "../../config/typescript/base.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "strictNullChecks": true,
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022",
    "ignoreDeprecations": "5.0",
    "paths": {
      "@capabilities/work-core": ["../work-core/contracts/work.contracts.ts"],
      "@capabilities/work-core/*": ["../work-core/*"]
    }
  },
  "include": ["implementation/**/*.ts", "contracts/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.d.ts"]
}