# EOS Development Environment - Local Setup
# Copy this file to .env and fill in your values

# Database Configuration
POSTGRES_USER=eos_dev
POSTGRES_PASSWORD=eos_dev_password_123
POSTGRES_DB=eos_identity_dev
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
POSTGRES_CONNECTION_STRING=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Redis Configuration
REDIS_URL=redis://localhost:6379

# API Security Configuration (for local development)
ALLOWED_INTERNAL_NETWORKS="172.17.0.0/16,127.0.0.1/32,192.168.0.0/16"

# Path Configuration
EOS_EVIDENCE_STORAGE_ROOT=./data/evidence
EOS_REQUIREMENT_STORAGE_PATH=./data/requirements/requirements.json

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NODE_ENV=development

# EOS Core Configuration
EOS_CONSTITUTION_ATTESTATION_PROFILE=development