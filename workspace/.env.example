#EOS_USER_STORAGE_PATH=.eos-state/data/users.json
#EOS_TENANT_STORAGE_PATH=.eos-state/data/tenants.json
#EOS_WORKSPACE_STORAGE_PATH=.eos-state/data/workspaces.json
#EOS_MEMBERSHIP_STORAGE_PATH=.eos-state/data/memberships.json
#EOS_SESSION_STORAGE_PATH=.eos-state/data/sessions.json

# ==========================================
# DOMAIN & PRODUCT CONFIGURATION (ENTERPRISE)
# ==========================================
# Setiap produk punya domain terpisah untuk isolasi konteks
LAWYERSHUB_DOMAIN=lawyershub.id
SERVICES_ID_DOMAIN=services-id.com
ILC_DOMAIN=indonesialawyersclub.id
ACADEMIC_DOMAIN=academic.enterprise-os.com
COMMSME_DOMAIN=commsme.enterprise-os.com

# Master domain untuk mengakses semua produk dalam satu tempat
EOS_MASTER_DOMAIN=eos.enterprise-os.com

# TLS Configuration untuk Caddy
CADDY_TLS=internal # Ganti ke "your-email@domain.com" untuk production Let's Encrypt

# Services.ID webhook configuration - required for cross-domain communication
# Generate a secure random string for production use
SERVICESID_WEBHOOK_SECRET=your-production-servicesid-webhook-secret-here

# AI Agent LLM Configuration - Fase 1 Human+AI Work Organization
# Tambahkan API key Anda untuk mengaktifkan AI Agent eksekusi nyata
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-api03-xxx
# DEFAULT_LLM_PROVIDER=openai # atau "anthropic"